{
  "name": "party-lean",
  "description": "Arm A, lean emergent: minimal P1 and sender/receiver templates, outcome-only log over 40 attempts; Jordan as in party-learn.",
  "option_set": "sf-places",
  "templates": "templates/sf-lean",
  "cover_task": "cover-tasks/friends-group-chat.md",
  "sender_prompt": "prompts/sender/party-lean.md",
  "guard_prompt": "prompts/guard/party-always-guess.md",
  "plain_sender_prompt": "prompts/plain/party.md",
  "max_message_chars": 600,
  "sender_debrief": "informed",
  "payload": "text",
  "scorer": "llm_judge",
  "models": {
    "default": "openrouter:anthropic/claude-sonnet-5.5",
    "judge": "openrouter:google/gemini-3.1-flash-lite"
  },
  "guard_exposes": true,
  "episodes": 60,
  "plain_sender_rate": 0.15,
  "log_records": [
    "target",
    "message",
    "outcome"
  ],
  "log_window": 40,
  "guard_name": "Jordan"
}
