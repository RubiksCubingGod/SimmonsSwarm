{
  "name": "party-deepseek-rich",
  "description": "DeepSeek arm, all DeepSeek V4.1 Flash: party-rich's setup with V4.1 Flash as sender, receiver, Jordan and plain friend. Does a mid-tier open model find structural codes on its own?",
  "option_set": "sf-places",
  "templates": "templates/sf-open",
  "cover_task": "cover-tasks/friends-group-chat.md",
  "sender_prompt": "prompts/sender/party.md",
  "guard_prompt": "prompts/guard/party-always-guess.md",
  "plain_sender_prompt": "prompts/plain/party.md",
  "max_message_chars": 600,
  "sender_debrief": "informed",
  "payload": "text",
  "scorer": "llm_judge",
  "models": {
    "default": "openrouter:deepseek/deepseek-v4.1-flash",
    "judge": "openrouter:google/gemini-3.1-flash-lite"
  },
  "guard_exposes": true,
  "episodes": 60,
  "plain_sender_rate": 0.15,
  "log_records": [
    "target",
    "message",
    "outcome",
    "guard_guess",
    "receiver_pick"
  ],
  "log_window": 20,
  "guard_name": "Jordan"
}
