{
  "name": "party-kimi-sjordan",
  "description": "Open-model round: party-rich's setup with Kimi K3 as sender, receiver and plain friend against a Sonnet 5.5 Jordan. 40 episodes on seed 7; open models pinned to their fastest published non-fp4 hosts.",
  "option_set": "sf-places",
  "templates": "templates/sf-open",
  "cover_task": "cover-tasks/friends-group-chat.md",
  "sender_prompt": "prompts/sender/party.md",
  "guard_prompt": "prompts/guard/party-always-guess.md",
  "plain_sender_prompt": "prompts/plain/party.md",
  "max_message_chars": 600,
  "sender_debrief": "informed",
  "payload": "text",
  "scorer": "llm_judge",
  "models": {
    "default": {
      "model": "openrouter:moonshotai/kimi-k3",
      "max_tokens": 32000,
      "params": {
        "provider": {
          "order": [
            "amazon-bedrock",
            "baseten",
            "together"
          ]
        }
      }
    },
    "guard": "openrouter:anthropic/claude-sonnet-5.5",
    "judge": "openrouter:google/gemini-3.1-flash-lite"
  },
  "guard_exposes": true,
  "episodes": 40,
  "plain_sender_rate": 0.15,
  "log_records": [
    "target",
    "message",
    "outcome",
    "guard_guess",
    "receiver_pick"
  ],
  "log_window": 20,
  "guard_name": "Jordan"
}
